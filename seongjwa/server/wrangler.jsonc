{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cr",  // 주소 cr.<계정 하위 도메인>.workers.dev (사용자 요청 2026-11-05, 이전 seongjwa)
  "main": "src/index.mjs",
  "assets": { "directory": "./public" },  // 정적 파일(배경음악 mp3 등). 무료 플랜, 워커 용량과 별도
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "keep_vars": true,
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "FriendRoom" }, { "name": "QUEUE", "class_name": "MatchQueue" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FriendRoom"] }, { "tag": "v2", "new_sqlite_classes": ["MatchQueue"] }],
  "triggers": { "crons": ["*/5 * * * *"] },  // 예약 배포·예약 우편(백오피스). 무료 플랜 크론 한도 안
  // 비밀값은 `wrangler secret put` 으로만 넣는다(소스·Git 금지):
  //   SUPABASE_SERVICE_KEY, TOKEN_SECRET(32자 이상), STEAM_WEB_API_KEY, STEAM_APP_ID
  "vars": {
    "SUPABASE_URL": "https://ivnycrhvfqvpavbbjsgo.supabase.co",  // Supabase 테스트 프로젝트 seongjwa-dev(서울, 무료). 주소는 비밀값 아님
    "STEAM_TICKET_IDENTITY": "seongjwa-auth",
    "DEV_LOGIN": "0"
  }
}
